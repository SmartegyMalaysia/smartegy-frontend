# Local values are printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-local-anon-key

# Exact public application origin used for authentication redirects (no path or trailing slash).
SITE_URL=http://localhost:3000

# Leave unset to use the development mock preview. Set to `false` for Supabase-backed data.
NEXT_PUBLIC_USE_MOCKS=false

# Development-only. This is ignored in production even when set to true.
NEXT_PUBLIC_ENABLE_DEVELOPER_PREVIEW=false
